   { "who": "lea", "text": "C'est tout, merci. C'est combien ?", "bg": "Това е всичко, благодаря. Колко струва?" },
   { "who": "boulangere", "text": "Deux euros, s'il te plaît.", "bg": "Две евро, моля." },
   { "who": "lea", "text": "Merci ! Au revoir, madame !", "bg": "Благодаря! Довиждане, госпожо!" }
  ] },
  { "id": "ecole", "title": "В училище", "img": "school", "lines": [
