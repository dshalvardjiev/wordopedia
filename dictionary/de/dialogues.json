   { "who": "lehrerin", "text": "Kein Problem. Hier ist ein Buch für dich.", "bg": "Няма проблем. Ето една книга за теб." },
   { "who": "ben", "text": "Danke schön, Frau Klein!", "bg": "Благодаря, госпожо Клайн!" }
  ] },
  { "id": "familie", "title": "Семейство", "img": "family", "lines": [
   { "who": "anna", "text": "Hast du Geschwister?", "bg": "Имаш ли братя и сестри?" },
