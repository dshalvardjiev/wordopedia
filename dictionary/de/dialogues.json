   { "who": "anna", "text": "Nein, danke. Was kostet das?", "bg": "Не, благодаря. Колко струва?" },
   { "who": "baecker", "text": "Das kostet zwei Euro.", "bg": "Струва две евро." },
   { "who": "anna", "text": "Danke! Auf Wiedersehen!", "bg": "Благодаря! Довиждане!" }
  ] },
  { "id": "schule", "title": "В училище", "img": "school", "lines": [
